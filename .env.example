# ──────────────────────────────────────────────────────────────────────────────
# Copy to .env (scripts/setup.sh does this and generates the secrets for you).
# NEVER commit .env. Passwords and API keys live ONLY here; the web UI can show
# whether each one is set, but never its value.
# ──────────────────────────────────────────────────────────────────────────────

# --- database ---------------------------------------------------------------
POSTGRES_USER=neurogrid
POSTGRES_PASSWORD=change-me-use-setup-sh
POSTGRES_DB=neurogrid
# Used when running outside Docker (development). Inside Docker compose builds it from the values above.
DATABASE_URL=postgresql+psycopg://neurogrid:neurogrid_dev_password@127.0.0.1:55432/neurogrid
DB_HOST_PORT=55432

# --- app --------------------------------------------------------------------
# development | production. Production refuses a weak SECRET_KEY.
ENVIRONMENT=production
# 32+ random characters. Signs unsubscribe links. Changing it breaks old unsubscribe links.
SECRET_KEY=generate-with-scripts-setup-sh
# First admin user, created on first start only. Remove ADMIN_PASSWORD from this file afterwards.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# The public address of this app. Use https://… when deployed (enables one-click unsubscribe links).
PUBLIC_BASE_URL=http://localhost:8000
# Session cookies are marked Secure when true. Set true behind HTTPS.
COOKIE_SECURE=false
HOST_PORT=8000
# Comma-separated reverse-proxy IPs whose X-Forwarded-For header is trusted (Docker network when using Caddy).
FORWARDED_ALLOW_IPS=127.0.0.1

# --- safety switch ------------------------------------------------------------
# Real email can only leave when this is true AND live mode is on in Settings AND a campaign is confirmed.
LIVE_SENDING_ENABLED=false

# --- your mailbox: sending (SMTP) and replies/bounces (IMAP) -----------------------
# Gmail/Workspace example: smtp.gmail.com 587 starttls with an App Password; imap.gmail.com 993.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
IMAP_HOST=
IMAP_PORT=993
IMAP_SSL=true
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
# Optional: where your provider stores sent mail (used only to help resolve "unknown" sends)
IMAP_SENT_MAILBOX=

# --- optional paid services -----------------------------------------------------
# Without these the app still works using free fixed rules for research and drafts.
ANTHROPIC_API_KEY=
TAVILY_API_KEY=
